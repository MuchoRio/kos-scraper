# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force specific binary extensions
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
*.xlsx binary
*.jar binary

# Ensure shell scripts always retain LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Ensure Windows batch scripts retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

